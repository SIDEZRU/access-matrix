{
	"name": "sidez/access-matrix",
	"description": "Матрица выдачи доступа к приложениям Nextcloud по группам",
	"license": "AGPL-3.0-or-later",
	"authors": [
		{
			"name": "SIDEZ LLC"
		}
	],
	"autoload": {
		"psr-4": {
			"OCA\\AccessMatrix\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\AccessMatrix\\Tests\\": "tests/",
			"OCP\\": "vendor/nextcloud/ocp/OCP/",
			"NCU\\": "vendor/nextcloud/ocp/NCU/"
		}
	},
	"require": {
		"php": "^8.3"
	},
	"require-dev": {
		"nextcloud/ocp": "^35.0",
		"phpunit/phpunit": "^11.5"
	},
	"scripts": {
		"test": "phpunit --configuration phpunit.xml"
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.3"
		}
	}
}
